#!/bin/sh
# Mantém version.py igual à versão do commit.
# Se o título do commit começa com uma versão ("1.2.0", "v1.2.0" ou
# "1.2.0 correção do envio"), grava essa versão em version.py e emenda o commit
# com ela. O commit emendado dispara este hook de novo, que então não faz nada.

version=$(git log -1 --format=%s | sed -n -E 's/^v?([0-9]+\.[0-9]+\.[0-9]+)([[:space:]].*)?$/\1/p')
[ -n "$version" ] || exit 0

# rebase e cherry-pick reaplicam commits que já passaram por aqui
git_dir=$(git rev-parse --git-dir)
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

committed=$(git show HEAD:version.py 2>/dev/null | tr -d '\r' | sed -n -E 's/^APP_VERSION = "(.*)"$/\1/p')
[ "$committed" = "$version" ] && exit 0

cat > version.py <<EOF
"""Versão do EventUploader.

Não edite à mão: o hook .githooks/post-commit reescreve este arquivo quando o
título do commit começa com uma versão (ex.: "1.2.0" ou "1.2.0 correção do envio").
"""
APP_VERSION = "$version"
EOF

# --only: emenda só o version.py, sem levar outras mudanças que estejam no index
git commit --amend --no-edit --no-verify --only -- version.py >/dev/null || exit 1
echo "version.py atualizado para $version"
